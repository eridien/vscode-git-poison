{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "/root/wsl-apps/test"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    }
  ]
}
