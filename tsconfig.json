{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [  "ES2020" ],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": ["node"],    
    "declaration": false,
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [ "src/**/*" ],
  "exclude": ["node_modules", "out"]
}
